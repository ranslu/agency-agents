{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "mcp__github",
      "mcp__Firecrawl",
      "mcp__claude-code-remote",
      "mcp__agency",
      "mcp__brave-search",
      "mcp__apify",
      "mcp__shodan",
      "mcp__xero",
      "mcp__currents",
      "mcp__google-maps",
      "mcp__neo4j",
      "mcp__dbt",
      "mcp__fhir",
      "mcp__mermaid",
      "mcp__excalidraw"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin --delete *)",
      "Bash(git push origin :*)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf .git *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
